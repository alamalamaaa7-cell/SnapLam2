# ─────────────────────────────────────────────────────────────
# SnapLam - Downloader v1.3  •  Environment variables
# Copy this file to .env and fill in the values.
# On Railway, add these under Project → Variables.
# ─────────────────────────────────────────────────────────────

# Google OAuth (NextAuth). Create at https://console.cloud.google.com
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth session secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL of the app. On Railway set this to your generated domain,
# e.g. https://snaplam.up.railway.app  (locally: http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000

# MongoDB Atlas connection string (must include a database name).
# e.g. mongodb+srv://user:pass@cluster.mongodb.net/snaplam?retryWrites=true&w=majority
MONGODB_URI=

# Upstash Redis (rediss:// URL). Used for BullMQ queue, cache & rate-limit.
# OPTIONAL — if omitted the app falls back to inline processing + memory limits.
UPSTASH_REDIS_URL=

# Admin account. This email is auto-promoted to ADMIN on first login.
ADMIN_EMAIL=lamzy103@gmail.com

# Port. Railway injects PORT automatically; keep 3000 for local dev.
PORT=3000
