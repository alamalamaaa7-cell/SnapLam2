// SnapLam - Downloader v1.3 — Prisma schema (MongoDB Atlas)
// Docs: https://www.prisma.io/docs/orm/overview/databases/mongodb

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

enum Role {
  USER
  ADMIN
}

enum DownloadStatus {
  PROSES
  SUKSES
  GAGAL
}

enum BroadcastType {
  INFO
  UPDATE
  MAINTENANCE
}

// ── NextAuth models (Prisma adapter) ─────────────────────────────
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── Core app models ──────────────────────────────────────────────
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)

  totalDownloads Int      @default(0)
  isBanned       Boolean  @default(false)
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  accounts     Account[]
  sessions     Session[]
  downloads    Download[]
  messages     ChatMessage[]
  reads        BroadcastRead[]
}

model Download {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?        @db.ObjectId
  email     String?
  url       String         @db.String
  platform  String
  title     String?
  thumbnail String?        @db.String
  duration  String?
  format    String?        // MP4 | MP3 | IMAGE
  status    DownloadStatus @default(PROSES)
  error     String?        @db.String
  ip        String?
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([platform])
  @@index([status])
  @@index([createdAt])
}

model ChatMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  email     String?
  name      String?
  image     String?
  role      Role     @default(USER)
  content   String   @db.String
  pinned    Boolean  @default(false)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Broadcast {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String        @db.String
  type      BroadcastType @default(INFO)
  createdAt DateTime      @default(now())

  reads BroadcastRead[]
}

model BroadcastRead {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  broadcastId String   @db.ObjectId
  userId      String   @db.ObjectId
  readAt      DateTime @default(now())

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
}

// Single-row settings document controlled from the admin dashboard.
model Settings {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  key             String  @unique @default("global")
  theme           String  @default("abu")   // abu | biru | putih | orange | emas
  dailyLimit      Int     @default(20)
  maintenanceMode Boolean @default(false)
  updatedAt       DateTime @updatedAt
}
